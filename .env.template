# ============================================================================
# NQBA Framework Environment Configuration Template
# ============================================================================
# Copy this file to .env and configure with your specific values:
#   cp .env.template .env
#
# IMPORTANT: Never commit .env to version control - it contains secrets!
# The .env file is listed in .gitignore for your protection.
# ============================================================================

# ============================================================================
# QUANTUM COMPUTING CONFIGURATION
# ============================================================================

# Maximum number of qubits to use in quantum simulations
# Range: 4-64 (higher values require more memory)
# Default: 32 (suitable for most applications)
# Note: Real quantum hardware limits may differ from simulation
QUANTUM_MAX_QUBITS=32

# Quantum computing backend selection
# Options: qiskit, cirq, pennylane, simulator
# - qiskit: IBM's quantum computing framework (recommended for production)
# - cirq: Google's quantum computing framework
# - pennylane: For quantum machine learning applications
# - simulator: Classical simulation (no quantum hardware required)
QUANTUM_BACKEND=qiskit

# Optimization level for quantum circuit compilation
# Range: 0-3
# - 0: No optimization (fastest compilation, slower execution)
# - 1: Light optimization (balanced)
# - 2: Medium optimization (recommended for production)
# - 3: Heavy optimization (slowest compilation, fastest execution)
QUANTUM_OPTIMIZATION_LEVEL=2

# ============================================================================
# DYNEX NEUROMORPHIC COMPUTING INTEGRATION
# ============================================================================

# Dynex API Key - Required for neuromorphic acceleration
# Get your API key from: https://dynex.network/dashboard/api-keys
# This enables quantum-inspired computing on Dynex's neuromorphic platform
DYNEX_API_KEY=your_dynex_api_key_here

# Dynex Network Selection
# Options: mainnet, testnet
# - mainnet: Production network (costs DNX tokens)
# - testnet: Development/testing network (free, limited resources)
# Use testnet for development and mainnet for production workloads
DYNEX_NETWORK=mainnet

# Optional: Dynex API endpoint (only change if using custom deployment)
# DYNEX_ENDPOINT=https://api.dynex.network/v1

# Optional: Maximum number of parallel Dynex workers
# Default: 4 (adjust based on your subscription tier)
# DYNEX_MAX_WORKERS=4

# ============================================================================
# AI & LLM SERVICES
# ============================================================================

# OpenAI API Key - Required for GPT models and embeddings
# Get your key from: https://platform.openai.com/api-keys
# Used for: natural language processing, embeddings, chat completions
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key - Optional, for Claude models
# Get your key from: https://console.anthropic.com/
# Used for: advanced reasoning, long-context processing
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: nuco.cloud integration key
# Get your key from: https://nuco.cloud/dashboard
# Enables elastic quantum resources and hybrid cloud architecture
# NUCO_CLOUD_KEY=your_nuco_cloud_key_here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database URL - SQLAlchemy compatible connection string
# Examples:
# - SQLite (development): sqlite:///./nqba.db
# - PostgreSQL: postgresql://user:password@localhost:5432/nqba
# - MySQL: mysql://user:password@localhost:3306/nqba
# DATABASE_URL=sqlite:///./nqba.db

# Optional: Database connection pool settings
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# ============================================================================
# REDIS CACHE & MESSAGE QUEUE
# ============================================================================

# Redis connection URL for caching and task queue
# Format: redis://[:password]@host:port/db
# Default uses local Redis without authentication
# REDIS_URL=redis://localhost:6379/0

# Optional: Redis password if authentication is enabled
# REDIS_PASSWORD=your_redis_password

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# Secret key for JWT token generation
# CRITICAL: Generate a strong random key for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET=your_jwt_secret_here

# Encryption key for sensitive data at rest
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ENCRYPTION_KEY=your_encryption_key_here

# Session timeout in minutes (default: 60)
# SESSION_TIMEOUT=60

# Enable multi-factor authentication (true/false)
# MFA_ENABLED=false

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level controls verbosity of application logs
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# - DEBUG: Detailed information for diagnosing problems
# - INFO: General informational messages (recommended for production)
# - WARNING: Warning messages for potential issues
# - ERROR: Error messages for serious problems
# - CRITICAL: Critical errors that may cause system failure
LOG_LEVEL=INFO

# Log file path - logs are written to this file
# Ensure the directory exists and has write permissions
# Use absolute path or relative to project root
LOG_FILE=logs/nqba_framework.log

# Optional: Enable JSON-formatted logs for log aggregation systems
# JSON_LOGS=false

# Optional: Log rotation settings
# MAX_LOG_SIZE_MB=100
# MAX_LOG_FILES=10

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment designation
# Options: development, staging, production
# - development: Local development with debug features enabled
# - staging: Pre-production testing environment
# - production: Production environment with optimizations
ENVIRONMENT=production

# Debug mode - enables detailed error pages and auto-reload
# CRITICAL: Always set to False in production for security
# Options: True, False
DEBUG=False

# Application host and port
# HOST=0.0.0.0
# PORT=8080

# CORS (Cross-Origin Resource Sharing) settings
# Comma-separated list of allowed origins
# Use "*" to allow all origins (NOT recommended for production)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# BUSINESS POD CONFIGURATION
# ============================================================================

# Enable/disable specific business pods
# Set to true/false to control which business modules are loaded
# ENABLE_FLYFOX_AI_POD=true
# ENABLE_GOLIATH_TRADE_POD=true
# ENABLE_SIGMA_SELECT_POD=true
# ENABLE_GHOST_NEUROQ_POD=true

# ============================================================================
# PERFORMANCE & SCALING
# ============================================================================

# Maximum concurrent requests (for load balancing)
# MAX_WORKERS=4

# Request timeout in seconds
# REQUEST_TIMEOUT=300

# Enable caching for improved performance
# ENABLE_CACHE=true

# Cache TTL (time-to-live) in seconds
# CACHE_TTL=3600

# ============================================================================
# COMPLIANCE & GOVERNANCE
# ============================================================================

# Enable compliance checks (GDPR, HIPAA, SOC2, etc.)
# COMPLIANCE_ENABLED=true

# Data retention policy in days
# DATA_RETENTION_DAYS=2555  # 7 years for financial data

# Enable audit logging for all operations
# AUDIT_LOGGING=true

# ============================================================================
# TESTING & DEVELOPMENT
# ============================================================================

# Test mode - enables test-specific behaviors
# TEST_MODE=false

# Use mock services instead of real APIs (for testing)
# USE_MOCK_SERVICES=false

# Pytest configuration
# PYTEST_TIMEOUT=300

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# Stripe API key for payment processing (optional)
# STRIPE_API_KEY=your_stripe_api_key_here
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# SendGrid API key for email notifications (optional)
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Slack webhook for notifications (optional)
# SLACK_WEBHOOK_URL=your_slack_webhook_url

