# Goliath Quantum Division - NQBA Engine Dockerfile
# Production-ready container for Neuromorphic Quantum Business Architecture

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install additional quantum computing dependencies
RUN pip install --no-cache-dir \
    dimod==0.12.21 \
    fastapi==0.116.1 \
    uvicorn==0.35.0 \
    pydantic==1.10.12 \
    redis==5.0.1 \
    psycopg2-binary==2.9.9 \
    sqlalchemy==1.4.53 \
    alembic==1.13.1 \
    prometheus-client==0.19.0 \
    structlog==23.2.0

# Copy application code
COPY src/ ./src/
COPY api/ ./api/
COPY data/ ./data/
COPY *.py ./

# Create necessary directories
RUN mkdir -p logs cache data/leads data/processed data/quantum_cache

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production

# Create non-root user for security
RUN useradd -m -u 1000 goliath && \
    chown -R goliath:goliath /app
USER goliath

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Start NQBA Engine
CMD ["python", "-m", "uvicorn", "src.nqba.api_server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]