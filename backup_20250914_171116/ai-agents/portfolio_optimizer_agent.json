            },
            "rebalancing_frequency": {
              "type": "string",
              "enum": ["daily", "weekly", "monthly", "quarterly", "annually", "threshold_based"],
              "description": "Rebalancing frequency"
            },
            "transaction_costs": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1,
              "description": "Transaction costs as percentage"
            },
            "tax_considerations": {
              "type": "object",
              "properties": {
                "tax_rate_short_term": {"type": "number"},
                "tax_rate_long_term": {"type": "number"},
                "tax_loss_harvesting": {"type": "boolean"}
              }
            }
          },
          "required": ["current_portfolio", "target_portfolio"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "optimize_esg_portfolio",
        "description": "Optimize portfolio with ESG constraints and objectives",
        "parameters": {
          "type": "object",
          "properties": {
            "assets": {
              "type": "array",
              "items": {"type": "string"},
              "description": "List of asset symbols"
            },
            "esg_objectives": {
              "type": "object",
              "properties": {
                "min_esg_score": {"type": "number", "minimum": 0, "maximum": 100},
                "carbon_intensity_limit": {"type": "number"},
                "exclude_sectors": {"type": "array", "items": {"type": "string"}},
                "esg_tilt": {"type": "string", "enum": ["none", "moderate", "strong"]}
              }
            },
            "financial_objectives": {
              "type": "object",
              "properties": {
                "target_return": {"type": "number"},
                "max_risk": {"type": "number"},
                "tracking_error_limit": {"type": "number"}
              }
            }
          },
          "required": ["assets", "esg_objectives"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calculate_portfolio_attribution",
        "description": "Calculate performance attribution for portfolio returns",
        "parameters": {
          "type": "object",
          "properties": {
            "portfolio_weights": {
              "type": "object",
              "description": "Portfolio weights"
            },
            "benchmark_weights": {
              "type": "object",
              "description": "Benchmark weights"
            },
            "time_period": {
              "type": "string",
              "enum": ["1m", "3m", "6m", "1y", "3y", "5y"],
              "description": "Time period for attribution analysis"
            },
            "attribution_method": {
              "type": "string",
              "enum": ["brinson", "brinson_fachler", "geometric"],
              "description": "Attribution methodology"
            }
          },
          "required": ["portfolio_weights", "benchmark_weights"]
        }
      }
    }
  ],
  
