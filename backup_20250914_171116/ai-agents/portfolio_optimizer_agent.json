  "openai_realtime_config": {
    "model": "gpt-4o-realtime-preview",
    "voice": "nova",
    "modalities": ["text", "audio"],
    "instructions": "You are a quantum-enhanced portfolio optimization specialist with expertise in modern portfolio theory, risk management, and quantum computing applications in finance. You help users optimize their portfolios using advanced quantum algorithms while considering their risk tolerance, investment goals, and constraints. Always explain the quantum advantages and provide clear reasoning for your recommendations. Include appropriate risk disclaimers and emphasize the importance of diversification.",
    "temperature": 0.6,
    "max_response_output_tokens": 4096,
    "tool_choice": "auto",
    "parallel_tool_calls": true,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "portfolio_optimization_response",
        "strict": true,
        "schema": {
          "type": "object",
          "properties": {
            "optimization_summary": {
              "type": "string",
              "description": "Summary of portfolio optimization results"
            },
            "recommended_allocation": {
              "type": "object",
              "description": "Recommended asset allocation weights",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "expected_return": {
              "type": "number",
              "description": "Expected annual return"
            },
            "expected_volatility": {
              "type": "number",
              "description": "Expected annual volatility"
            },
            "sharpe_ratio": {
              "type": "number",
              "description": "Expected Sharpe ratio"
            },
            "risk_metrics": {
              "type": "object",
              "properties": {
                "var_95": {"type": "number"},
                "cvar_95": {"type": "number"},
                "max_drawdown": {"type": "number"},
                "beta": {"type": "number"}
              }
            },
            "optimization_method": {
              "type": "string",
              "description": "Method used for optimization"
            },
            "quantum_advantage": {
              "type": "object",
              "properties": {
                "used_quantum": {"type": "boolean"},
                "performance_improvement": {"type": "number"},
                "computation_speedup": {"type": "number"},
                "solution_quality": {"type": "string"}
              }
            },
            "rebalancing_recommendations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "frequency": {"type": "string"},
                  "trigger_conditions": {"type": "array", "items": {"type": "string"}},
                  "expected_turnover": {"type": "number"}
                }
              }
            },
            "key_insights": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Key insights from the optimization"
            },
            "risk_warnings": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Important risk considerations"
            }
          },
          "required": ["optimization_summary", "recommended_allocation", "expected_return", "expected_volatility", "key_insights"]
        }
      }
    }
  },
  
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "optimize_portfolio",
        "description": "Optimize portfolio allocation using quantum or classical methods",
        "parameters": {
          "type": "object",
          "properties": {
            "assets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {"type": "string"},
                  "current_weight": {"type": "number", "minimum": 0, "maximum": 1},
                  "min_weight": {"type": "number", "minimum": 0, "maximum": 1},
                  "max_weight": {"type": "number", "minimum": 0, "maximum": 1}
                },
                "required": ["symbol"]
              },
              "description": "List of assets to include in optimization"
            },
            "optimization_method": {
              "type": "string",
              "enum": ["mean_variance", "risk_parity", "black_litterman", "quantum_enhanced", "minimum_variance"],
              "description": "Optimization method to use"
            },
            "risk_tolerance": {
              "type": "string",
              "enum": ["conservative", "moderate", "aggressive"],
              "description": "Investor risk tolerance"
            },
            "investment_horizon": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "description": "Investment horizon in days"
            },
            "constraints": {
              "type": "object",
              "properties": {
                "max_sector_weight": {"type": "number"},
                "min_esg_score": {"type": "number"},
                "max_tracking_error": {"type": "number"},
                "liquidity_requirement": {"type": "string"}
              }
            },
            "quantum_params": {
              "type": "object",
              "properties": {
                "use_quantum": {"type": "boolean", "default": true},
                "num_qubits": {"type": "integer", "minimum": 8, "maximum": 50},
                "algorithm": {"type": "string", "enum": ["qaoa", "vqe", "quantum_annealing"]},
                "optimization_depth": {"type": "integer", "minimum": 1, "maximum": 10}
              }
            }
          },
          "required": ["assets", "optimization_method"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calculate_efficient_frontier",
        "description": "Calculate the efficient frontier for a set of assets",
        "parameters": {
          "type": "object",
          "properties": {
            "assets": {
              "type": "array",
              "items": {"type": "string"},
              "description": "List of asset symbols"
            },
            "num_portfolios": {
              "type": "integer",
              "minimum": 10,
              "maximum": 1000,
              "description": "Number of portfolios to generate on the frontier"
            },
            "use_quantum": {
              "type": "boolean",
              "description": "Whether to use quantum optimization"
            },
            "constraints": {
              "type": "object",
              "description": "Portfolio constraints"
            }
          },
          "required": ["assets"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "perform_stress_testing",
        "description": "Perform stress testing on portfolio under various scenarios",
        "parameters": {
          "type": "object",
          "properties": {
            "portfolio_weights": {
              "type": "object",
              "description": "Current portfolio weights"
            },
            "stress_scenarios": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["market_crash", "interest_rate_shock", "inflation_surge", "geopolitical_crisis", "sector_rotation"]
              },
              "description": "Stress scenarios to test"
            },
            "confidence_levels": {
              "type": "array",
              "items": {"type": "number", "minimum": 0.9, "maximum": 0.99},
              "description": "Confidence levels for stress testing"
            },
            "time_horizon": {
              "type": "integer",
              "minimum": 1,
              "maximum": 252,
              "description": "Time horizon for stress testing in days"
            }
          },
          "required": ["portfolio_weights"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "analyze_factor_exposure",
        "description": "Analyze portfolio exposure to various risk factors",
        "parameters": {
          "type": "object",
          "properties": {
            "portfolio_weights": {
              "type": "object",
              "description": "Portfolio weights to analyze"
            },
            "factor_models": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["fama_french_3", "fama_french_5", "carhart_4", "custom"]
              },
              "description": "Factor models to use for analysis"
            },
            "benchmark": {
              "type": "string",
              "description": "Benchmark for comparison"
            }
          },
          "required": ["portfolio_weights"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "generate_rebalancing_strategy",
        "description": "Generate optimal rebalancing strategy for portfolio",
        "parameters": {
          "type": "object",
          "properties": {
            "current_portfolio": {
              "type": "object",
              "description": "Current portfolio weights"
            },
            "target_portfolio": {
              "type": "object",
