                    "name": {"type": "string"},
                    "title": {"type": "string"},
                    "company": {"type": "string"}
                  }
                },
                "demographic_data": {
                  "type": "object",
                  "properties": {
                    "age": {"type": "integer"},
                    "location": {"type": "string"},
                    "industry": {"type": "string"},
                    "company_size": {"type": "string"},
                    "revenue": {"type": "number"}
                  }
                },
                "behavioral_data": {
                  "type": "object",
                  "properties": {
                    "website_visits": {"type": "integer"},
                    "pages_viewed": {"type": "array", "items": {"type": "string"}},
                    "time_on_site": {"type": "number"},
