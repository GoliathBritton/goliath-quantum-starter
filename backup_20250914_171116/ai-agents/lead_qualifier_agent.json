              "description": "Scoring model to use"
            },
            "quantum_params": {
              "type": "object",
              "properties": {
                "use_quantum": {"type": "boolean", "default": true},
                "feature_mapping": {"type": "string", "enum": ["linear", "polynomial", "rbf", "quantum"]},
                "quantum_depth": {"type": "integer", "minimum": 1, "maximum": 10},
                "entanglement_strategy": {"type": "string", "enum": ["linear", "circular", "full"]}
              }
