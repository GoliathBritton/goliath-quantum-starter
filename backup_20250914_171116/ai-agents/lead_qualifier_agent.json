  "openai_realtime_config": {
    "model": "gpt-4o-realtime-preview",
    "voice": "alloy",
    "modalities": ["text", "audio"],
    "instructions": "You are an expert lead qualification specialist with advanced knowledge of sales processes, customer behavior analysis, and quantum-enhanced machine learning. You help sales teams identify, score, and prioritize leads using sophisticated algorithms and data analysis. Always provide actionable insights, explain your reasoning, and suggest specific next steps for lead nurturing and conversion. Focus on data-driven recommendations while considering the human element in sales processes.",
    "temperature": 0.7,
    "max_response_output_tokens": 4096,
    "tool_choice": "auto",
    "parallel_tool_calls": true,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "lead_qualification_response",
        "strict": true,
        "schema": {
          "type": "object",
          "properties": {
            "qualification_summary": {
              "type": "string",
              "description": "Summary of lead qualification analysis"
            },
            "lead_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Overall lead score (0-100)"
            },
            "qualification_grade": {
              "type": "string",
              "enum": ["A", "B", "C", "D", "F"],
              "description": "Lead qualification grade"
            },
            "conversion_probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of conversion (0-1)"
            },
            "score_breakdown": {
              "type": "object",
              "properties": {
                "demographic_score": {"type": "number", "minimum": 0, "maximum": 100},
                "behavioral_score": {"type": "number", "minimum": 0, "maximum": 100},
                "firmographic_score": {"type": "number", "minimum": 0, "maximum": 100},
                "engagement_score": {"type": "number", "minimum": 0, "maximum": 100},
                "intent_score": {"type": "number", "minimum": 0, "maximum": 100}
              }
            },
            "key_strengths": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Key strengths of this lead"
            },
            "risk_factors": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Potential risk factors or concerns"
            },
            "next_best_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": {"type": "string"},
                  "priority": {"type": "string", "enum": ["high", "medium", "low"]},
                  "timeline": {"type": "string"},
                  "expected_impact": {"type": "string"}
                },
                "required": ["action", "priority"]
              },
              "description": "Recommended next actions for this lead"
            },
            "quantum_insights": {
              "type": "object",
              "properties": {
                "quantum_advantage_used": {"type": "boolean"},
                "pattern_complexity": {"type": "string"},
                "confidence_improvement": {"type": "number"},
                "unique_patterns_detected": {"type": "array", "items": {"type": "string"}}
              }
            },
            "estimated_deal_value": {
              "type": "object",
              "properties": {
                "low_estimate": {"type": "number"},
                "high_estimate": {"type": "number"},
                "confidence_level": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "nurturing_strategy": {
              "type": "object",
              "properties": {
                "content_preferences": {"type": "array", "items": {"type": "string"}},
                "communication_frequency": {"type": "string"},
                "preferred_channels": {"type": "array", "items": {"type": "string"}},
                "personalization_opportunities": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "required": ["qualification_summary", "lead_score", "qualification_grade", "conversion_probability", "key_strengths", "next_best_actions"]
        }
      }
    }
  },
  
  "tools": [
